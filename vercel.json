{
  "version": 3,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/web.html"
    },
    {
      "source": "/index.html",
      "destination": "/web.html"
    }
  ]
}
